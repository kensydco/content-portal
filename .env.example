# ===========================================
# Server Configuration
# ===========================================
PORT=8080
NODE_ENV=development

# ===========================================
# Google Cloud Credentials
# ===========================================
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# Google Sheets IDs (Single Spreadsheet, Multiple Sheets)
# ===========================================
# You can use ONE spreadsheet with multiple sheet tabs, or separate spreadsheets
SPREADSHEET_ID=your-main-spreadsheet-id
# Sheet tab names (these are the tab names within the spreadsheet)
CONTENT_SHEET_NAME=Content_Log
AUDIT_SHEET_NAME=Admin_Audit_Log
CATEGORIES_SHEET_NAME=Categories
CONFIG_SHEET_NAME=Configuration
ADMINS_SHEET_NAME=Admins

# ===========================================
# Google Drive
# ===========================================
DRIVE_FOLDER_ID=your-drive-folder-id

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-key-min-32-chars-long-for-security
JWT_EXPIRES_IN=8h

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=5

# ===========================================
# Automation API (for downstream bots)
# ===========================================
AUTOMATION_API_KEY=your-automation-api-key

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Content Ingest Portal
WAIVER_URL=https://your-domain.com/waiver
MAX_FILE_SIZE_MB=500
